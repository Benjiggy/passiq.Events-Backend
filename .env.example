# Server Configuration
PORT=5000
NODE_ENV=development
API_PREFIX=/api
FRONTEND_URL=http://localhost:5173

# Database Configuration (MongoDB)
# If MongoDB is not running locally, backend will automatically use in-memory store for development
MONGODB_URI=mongodb://127.0.0.1:27017/passiq_events
DB=mongodb://127.0.0.1:27017/passiq_events

# Resend Email Configuration
RESEND_API_KEY=re_new_key_here
ADMIN_NOTIFICATION_EMAIL=Passiq.events@gmail.com
RESEND_FROM_EMAIL=Passiq Events <tickets@passiq.events>

# JWT Authentication
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_REFRESH_EXPIRES_IN=30d

# Platform Policy
PLATFORM_DEDUCTION_PERCENT=10

# Payment Gateways Configuration

# 1. Paystack (NGN, GHS, KES, ZAR)
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_WEBHOOK_SECRET=

# 2. Flutterwave (Cards, Mobile Money, Bank Transfer)
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-xxxxxxxxxxxxxxxxxxxx-X
FLUTTERWAVE_ENCRYPTION_KEY=FLWSECK_TESTxxxxxxxx
FLUTTERWAVE_WEBHOOK_SECRET=

# 3. Stripe (Global USD, EUR, GBP, Apple Pay, Google Pay)
STRIPE_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 4. Crypto Payment Gateways (USDT, USDC, BTC, ETH, SOL)
# Supports Coinbase Commerce, NOWPayments, Binance Pay & Custom Web3 EVM / TRON Wallets
CRYPTO_GATEWAY_PROVIDER=nowpayments # options: nowpayments, coinbase, web3_custom, simulated
NOWPAYMENTS_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
NOWPAYMENTS_IPN_SECRET=
COINBASE_COMMERCE_API_KEY=
COINBASE_COMMERCE_WEBHOOK_SECRET=

# Custom Web3 / Dedicated Receiver Crypto Wallets (Optional direct deposit)
CRYPTO_RECEIVER_USDT_TRC20=TXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRYPTO_RECEIVER_USDT_ERC20=0x0000000000000000000000000000000000000000
CRYPTO_RECEIVER_BTC=bc1qxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CRYPTO_RECEIVER_SOL=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email / Notification Configuration (Optional)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Passiq Events <no-reply@passiq.events>"
